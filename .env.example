# Postgres (Docker Compose) — copy this file to `.env` and adjust as needed.
POSTGRES_USER=sms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sms

# Prisma / app connection (host -> Docker Postgres on 5434).
# Credentials must match the POSTGRES_* values above.
DATABASE_URL="postgresql://sms:change-me@localhost:5434/sms?schema=public"
